rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'points', 'createdAt']) && 
             data.uid is string && 
             data.uid == request.auth.uid &&
             data.points is number &&
             data.createdAt == request.time;
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read, create: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
      
      allow update: if isSignedIn() && isValidId(userId) && userId == request.auth.uid && 
                       (
                         // Action: modify points (e.g., earn rewards)
                         (incoming().diff(existing()).affectedKeys().hasOnly(['points', 'updatedAt']))
                       );
    }

    // Videos Collection
    match /videos/{videoId} {
      allow list: if isSignedIn();
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(videoId) && incoming().authorId == request.auth.uid;
      allow update: if isSignedIn() && existing().authorId == request.auth.uid && incoming().authorId == request.auth.uid;
      allow delete: if isSignedIn() && existing().authorId == request.auth.uid;
    }
  }
}
